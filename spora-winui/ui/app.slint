// Spora Windows client — main window (design canvas 1b, "master-detail
// instrument"): the sidebar is the connection list, the detail pane is the
// status surface. The window is frameless: its caption strip and controls
// are ours (chrome.slint). Dialogs float over a smoke layer; the tray
// flyout is a separate window exported from here.

import { Theme, ConnectionItem, StatusLine, OwnRelayItem } from "theme.slint";
import { Sidebar } from "sidebar.slint";
import { DetailPane, EmptyPane, NewSharePane, CreatingPane, ErrorBanner } from "detail.slint";
import { SettingsPane } from "settings.slint";
import { ConnectDialog, DeleteDialog, RelayDialog, RemoveRelayDialog, RequiredDialog } from "dialogs.slint";
import { CaptionArea, WindowControls } from "chrome.slint";
import { TrayFlyout } from "flyout.slint";

export { TrayFlyout, ConnectionItem, StatusLine, OwnRelayItem }

export component AppWindow inherits Window {
    title: "Spora";
    icon: @image-url("assets/logo-square.svg");
    default-font-family: "IBM Plex Sans";
    default-font-size: 13.5px;
    preferred-width: 880px;
    preferred-height: 620px;
    min-width: 760px;
    min-height: 540px;
    background: Theme.surface-bg;
    // No system frame; the backend resizes at the edges (cursor + OS drag),
    // and there is nothing to resize while maximised.
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 6px;

    // ── Model (owned by Rust) ────────────────────────────────────────
    in property <[ConnectionItem]> shares;
    in property <[ConnectionItem]> uses;
    in property <[StatusLine]> status-lines;
    in property <string> selected-id;
    in property <string> selected-role;
    in property <ConnectionItem> selected;
    in property <[float]> selected-bars;
    in property <string> selected-elapsed;
    in property <string> pane: "empty";   // "empty" | "detail" | "new-share" | "creating" | "settings"
    in property <string> banner;
    in property <string> banner-action;   // the banner's fix, e.g. "OPEN SETTINGS"; "" = none
    in property <bool> maximized;

    // Settings (pushed from Rust; see SettingsPane)
    in-out property <string> settings-tab: "relays";
    in property <bool> settings-alert;
    in property <bool> use-spora;
    in property <bool> relays-available;
    in property <string> spora-shape;
    in property <string> spora-text;
    in property <[OwnRelayItem]> own-relays;
    in property <bool> telemetry-available;
    in property <bool> telemetry-on;
    in property <bool> telemetry-busy;
    in property <string> telemetry-shape;
    in property <string> telemetry-text;
    in property <string> device-id;
    in property <string> last-upload;
    in property <string> report-state;
    in property <string> report-text;

    // ── UI-local state ───────────────────────────────────────────────
    in-out property <string> new-share-name;
    in-out property <bool> renaming;
    in-out property <string> rename-text;
    in-out property <bool> show-connect-dialog;
    in-out property <bool> dialog-focus-name;
    in-out property <string> dialog-url;
    in-out property <string> dialog-name;
    in-out property <string> dialog-url-error;
    in-out property <bool> show-delete-dialog;
    in-out property <string> delete-id;
    in-out property <string> delete-role;
    in-out property <string> delete-label;
    in-out property <bool> show-relay-dialog;
    in-out property <string> relay-original;   // "" = adding a relay
    in-out property <bool> relay-had-token;
    in-out property <string> relay-endpoint;
    in-out property <string> relay-token;
    in-out property <bool> relay-clear-token;
    in-out property <string> relay-error;
    in-out property <bool> relay-busy;
    in-out property <bool> show-remove-relay-dialog;
    in-out property <string> remove-relay-endpoint;
    in-out property <bool> show-required-dialog;
    in property <string> required-notice;

    // ── Callbacks ────────────────────────────────────────────────────
    callback select(role: string, id: string);
    callback share-new();
    callback connect-new();
    callback toggle(id: string, role: string, on: bool);
    callback retry(role: string, id: string);
    callback delete(role: string, id: string);
    callback rename(role: string, id: string, label: string);
    callback copy(text: string);
    callback cancel-new-share();
    callback finish-new-share(id: string, label: string);
    callback dialog-save(url: string, name: string);
    callback dismiss-banner();
    callback banner-act();
    callback open-settings();
    callback settings-tab-changed(tab: string);
    callback set-use-spora(on: bool);
    callback relay-save(original: string, endpoint: string, token: string, clear-token: bool);
    callback relay-remove(endpoint: string);
    callback set-telemetry(on: bool);
    callback save-report();
    callback show-report();
    callback required-closed(contact: bool);
    // Window chrome
    callback start-drag();
    callback show-window-menu(x: length, y: length);
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    // The caption sits behind the content: whatever is interactive above it
    // (the controls, a banner's button) wins, everything else drags. The
    // sidebar's lockup, just below the strip, drags too.
    CaptionArea {
        x: 0; y: 0; width: root.width; height: 32px;
        start-drag => { root.start-drag(); }
        toggle-maximize => { root.toggle-maximize(); }
        show-menu(x, y) => { root.show-window-menu(x, y); }
    }
    CaptionArea {
        x: 0; y: 32px; width: 248px; height: 22px;
        start-drag => { root.start-drag(); }
        toggle-maximize => { root.toggle-maximize(); }
        show-menu(x, y) => { root.show-window-menu(x, y + self.y); }
    }

    HorizontalLayout {
        Sidebar {
            shares: root.shares;
            uses: root.uses;
            status-lines: root.status-lines;
            selected-id: root.selected-id;
            selected-role: root.pane == "settings" ? "" : root.selected-role;
            settings-selected: root.pane == "settings";
            settings-alert: root.settings-alert;
            select(role, id) => { root.renaming = false; root.select(role, id); }
            share-new => { root.share-new(); }
            connect-new => { root.connect-new(); }
            open-settings => { root.renaming = false; root.open-settings(); }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                alignment: stretch;
                if root.banner != "" : VerticalLayout {
                    padding-left: 30px;
                    padding-right: 30px;
                    padding-top: 40px;   // clear of the caption strip and its controls
                    ErrorBanner {
                        text: root.banner;
                        action-label: root.banner-action;
                        action => { root.banner-act(); }
                        dismiss => { root.dismiss-banner(); }
                    }
                }
                if root.pane == "empty" : EmptyPane {
                    share-new => { root.share-new(); }
                    connect-new => { root.connect-new(); }
                }
                if root.pane == "detail" : DetailPane {
                    item: root.selected;
                    bars: root.selected-bars;
                    elapsed: root.selected-elapsed;
                    renaming <=> root.renaming;
                    rename-text <=> root.rename-text;
                    toggle(id, role, on) => { root.toggle(id, role, on); }
                    copy(text) => { root.copy(text); }
                    retry(role, id) => { root.retry(role, id); }
                    delete(role, id) => {
                        root.delete-id = id;
                        root.delete-role = role;
                        root.delete-label = root.selected.label;
                        root.show-delete-dialog = true;
                    }
                    rename(role, id, label) => { root.rename(role, id, label); }
                }
                if root.pane == "new-share" : NewSharePane {
                    item: root.selected;
                    elapsed: root.selected-elapsed;
                    name <=> root.new-share-name;
                    copy(text) => { root.copy(text); }
                    done(id, label) => { root.finish-new-share(id, label); }
                }
                if root.pane == "creating" : CreatingPane {
                    cancel => { root.cancel-new-share(); }
                }
                if root.pane == "settings" : SettingsPane {
                    tab <=> root.settings-tab;
                    use-spora: root.use-spora;
                    relays-available: root.relays-available;
                    spora-shape: root.spora-shape;
                    spora-text: root.spora-text;
                    own-relays: root.own-relays;
                    telemetry-available: root.telemetry-available;
                    telemetry-on: root.telemetry-on;
                    telemetry-busy: root.telemetry-busy;
                    telemetry-shape: root.telemetry-shape;
                    telemetry-text: root.telemetry-text;
                    device-id: root.device-id;
                    last-upload: root.last-upload;
                    report-state: root.report-state;
                    report-text: root.report-text;
                    tab-changed(t) => { root.settings-tab-changed(t); }
                    set-use-spora(v) => { root.set-use-spora(v); }
                    add-relay => {
                        root.relay-original = "";
                        root.relay-had-token = false;
                        root.relay-endpoint = "";
                        root.relay-token = "";
                        root.relay-clear-token = false;
                        root.relay-error = "";
                        root.relay-busy = false;
                        root.show-relay-dialog = true;
                    }
                    edit-relay(r) => {
                        root.relay-original = r.endpoint;
                        root.relay-had-token = r.has-token;
                        root.relay-endpoint = r.endpoint;
                        root.relay-token = "";
                        root.relay-clear-token = false;
                        root.relay-error = "";
                        root.relay-busy = false;
                        root.show-relay-dialog = true;
                    }
                    remove-relay(e) => { root.remove-relay-endpoint = e; root.show-remove-relay-dialog = true; }
                    set-telemetry(v) => { root.set-telemetry(v); }
                    copy(t) => { root.copy(t); }
                    save-report => { root.save-report(); }
                    show-report => { root.show-report(); }
                }
            }
        }
    }

    WindowControls {
        x: root.width - self.width;
        y: 0;
        maximized: root.maximized;
        minimize => { root.minimize(); }
        toggle-maximize => { root.toggle-maximize(); }
        close => { root.close-window(); }
    }

    if root.show-connect-dialog : ConnectDialog {
        focus-name: root.dialog-focus-name;
        url <=> root.dialog-url;
        name <=> root.dialog-name;
        url-error: root.dialog-url-error;
        save(url, name) => { root.dialog-save(url, name); }
        cancel => { root.show-connect-dialog = false; root.dialog-url-error = ""; }
    }

    if root.show-relay-dialog : RelayDialog {
        editing: root.relay-original != "";
        had-token: root.relay-had-token;
        error: root.relay-error;
        busy: root.relay-busy;
        endpoint <=> root.relay-endpoint;
        token <=> root.relay-token;
        clear-token <=> root.relay-clear-token;
        save => { root.relay-save(root.relay-original, root.relay-endpoint, root.relay-token, root.relay-clear-token); }
        cancel => { root.show-relay-dialog = false; }
    }

    if root.show-remove-relay-dialog : RemoveRelayDialog {
        endpoint: root.remove-relay-endpoint;
        confirm => { root.show-remove-relay-dialog = false; root.relay-remove(root.remove-relay-endpoint); }
        cancel => { root.show-remove-relay-dialog = false; }
    }

    if root.show-required-dialog : RequiredDialog {
        message: root.required-notice;
        keep => { root.show-required-dialog = false; root.required-closed(false); }
        contact => { root.show-required-dialog = false; root.required-closed(true); }
    }

    if root.show-delete-dialog : DeleteDialog {
        label: root.delete-label;
        is-share: root.delete-role == "share";
        confirm => { root.show-delete-dialog = false; root.delete(root.delete-role, root.delete-id); }
        cancel => { root.show-delete-dialog = false; }
    }
}
