// Spora Windows client — main window (design canvas 1b, "master-detail
// instrument"): the sidebar is the connection list, the detail pane is the
// status surface. Dialogs float over a smoke layer; the tray flyout is a
// separate window exported from here.

import { Theme, ConnectionItem, StatusLine } from "theme.slint";
import { Sidebar } from "sidebar.slint";
import { DetailPane, EmptyPane, NewSharePane, CreatingPane, ErrorBanner } from "detail.slint";
import { ConnectDialog, DeleteDialog } from "dialogs.slint";
import { TrayFlyout } from "flyout.slint";

export { TrayFlyout, ConnectionItem, StatusLine }

export component AppWindow inherits Window {
    title: "Spora";
    icon: @image-url("assets/logo-square.svg");
    default-font-family: "IBM Plex Sans";
    default-font-size: 13.5px;
    preferred-width: 880px;
    preferred-height: 620px;
    min-width: 760px;
    min-height: 540px;
    background: Theme.surface-bg;

    // ── Model (owned by Rust) ────────────────────────────────────────
    in property <[ConnectionItem]> shares;
    in property <[ConnectionItem]> uses;
    in property <[StatusLine]> status-lines;
    in property <string> selected-id;
    in property <string> selected-role;
    in property <ConnectionItem> selected;
    in property <[float]> selected-bars;
    in property <string> selected-elapsed;
    in property <string> pane: "empty";   // "empty" | "detail" | "new-share" | "creating"
    in property <string> banner;

    // ── UI-local state ───────────────────────────────────────────────
    in-out property <string> new-share-name;
    in-out property <bool> renaming;
    in-out property <string> rename-text;
    in-out property <bool> show-connect-dialog;
    in-out property <bool> dialog-focus-name;
    in-out property <string> dialog-url;
    in-out property <string> dialog-name;
    in-out property <string> dialog-url-error;
    in-out property <bool> show-delete-dialog;
    in-out property <string> delete-id;
    in-out property <string> delete-role;
    in-out property <string> delete-label;

    // ── Callbacks ────────────────────────────────────────────────────
    callback select(role: string, id: string);
    callback share-new();
    callback connect-new();
    callback toggle(id: string, role: string, on: bool);
    callback retry(role: string, id: string);
    callback delete(role: string, id: string);
    callback rename(role: string, id: string, label: string);
    callback copy(text: string);
    callback cancel-new-share();
    callback finish-new-share(id: string, label: string);
    callback dialog-save(url: string, name: string);
    callback dismiss-banner();

    HorizontalLayout {
        Sidebar {
            shares: root.shares;
            uses: root.uses;
            status-lines: root.status-lines;
            selected-id: root.selected-id;
            selected-role: root.selected-role;
            select(role, id) => { root.renaming = false; root.select(role, id); }
            share-new => { root.share-new(); }
            connect-new => { root.connect-new(); }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                alignment: stretch;
                if root.banner != "" : VerticalLayout {
                    padding-left: 30px;
                    padding-right: 30px;
                    padding-top: 20px;
                    ErrorBanner { text: root.banner; dismiss => { root.dismiss-banner(); } }
                }
                if root.pane == "empty" : EmptyPane {
                    share-new => { root.share-new(); }
                    connect-new => { root.connect-new(); }
                }
                if root.pane == "detail" : DetailPane {
                    item: root.selected;
                    bars: root.selected-bars;
                    elapsed: root.selected-elapsed;
                    renaming <=> root.renaming;
                    rename-text <=> root.rename-text;
                    toggle(id, role, on) => { root.toggle(id, role, on); }
                    copy(text) => { root.copy(text); }
                    retry(role, id) => { root.retry(role, id); }
                    delete(role, id) => {
                        root.delete-id = id;
                        root.delete-role = role;
                        root.delete-label = root.selected.label;
                        root.show-delete-dialog = true;
                    }
                    rename(role, id, label) => { root.rename(role, id, label); }
                }
                if root.pane == "new-share" : NewSharePane {
                    item: root.selected;
                    elapsed: root.selected-elapsed;
                    name <=> root.new-share-name;
                    copy(text) => { root.copy(text); }
                    done(id, label) => { root.finish-new-share(id, label); }
                }
                if root.pane == "creating" : CreatingPane {
                    cancel => { root.cancel-new-share(); }
                }
            }
        }
    }

    if root.show-connect-dialog : ConnectDialog {
        focus-name: root.dialog-focus-name;
        url <=> root.dialog-url;
        name <=> root.dialog-name;
        url-error: root.dialog-url-error;
        save(url, name) => { root.dialog-save(url, name); }
        cancel => { root.show-connect-dialog = false; root.dialog-url-error = ""; }
    }

    if root.show-delete-dialog : DeleteDialog {
        label: root.delete-label;
        is-share: root.delete-role == "share";
        confirm => { root.show-delete-dialog = false; root.delete(root.delete-role, root.delete-id); }
        cancel => { root.show-delete-dialog = false; }
    }
}
